<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `ops/supervise.sh install` substitutes __UV__, __REPO__ and
  __HOME__ for this machine and writes the result to ~/Library/LaunchAgents.
  Nothing here may name a user: the repo is cloned onto other machines.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.missionhq.backend</string>

  <!--
    caffeinate -s holds the machine awake for as long as the backend runs.
    Without it the laptop sleeps through the schedules and every cron run
    fails: a run started at 08:22 sat suspended for hours, then died on a
    model request whose timeout could not fire because no timer was running.
    The assertion applies on AC power only, so nothing changes on battery.
    Drop the first two arguments to let the machine sleep normally again.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-s</string>
    <string>__UV__</string>
    <string>run</string>
    <string>python</string>
    <string>-m</string>
    <string>hq</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/backend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with almost no PATH. Anything the backend shells out
         to (uv, git, the claude CLI) has to be reachable from here. -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- Start at login and restart whenever the process exits, crash or not. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <!-- Back off so a crash loop cannot hammer the database. -->
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/backend.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/backend.log</string>
</dict>
</plist>
