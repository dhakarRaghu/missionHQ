<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `ops/proxy.sh caddy install` substitutes __REPO__ and __CADDY__ for
  this machine and writes the result to ~/Library/LaunchAgents.
  Nothing here may name a user: the repo is cloned onto other machines.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.missionhq.caddy</string>

  <!-- __CADDY__ is wherever `caddy` resolved at install time (Homebrew puts
       it in /opt/homebrew/bin on Apple Silicon, /usr/local/bin on Intel). -->
  <key>ProgramArguments</key>
  <array>
    <string>__CADDY__</string>
    <string>run</string>
    <string>--config</string>
    <string>__REPO__/ops/Caddyfile</string>
    <string>--adapter</string>
    <string>caddyfile</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <!-- Caddy keeps its state (no certificates here: the site is plain http
         on 127.0.0.1) under this directory instead of ~/Library. -->
    <key>XDG_DATA_HOME</key>
    <string>__REPO__/data/caddy</string>
    <key>XDG_CONFIG_HOME</key>
    <string>__REPO__/data/caddy</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/caddy.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/caddy.log</string>
</dict>
</plist>
