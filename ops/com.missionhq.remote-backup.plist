<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.missionhq.remote-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT__/ops/backup.sh</string>
    <string>sync-remote</string>
  </array>
  <key>WorkingDirectory</key><string>__ROOT__</string>
  <key>StandardOutPath</key><string>__ROOT__/data/logs/backup.log</string>
  <key>StandardErrorPath</key><string>__ROOT__/data/logs/backup.log</string>
  <key>RunAtLoad</key><false/>
  <!-- Sunday 04:10, after the nightly local dump at 03:30. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>10</integer>
  </dict>
</dict>
</plist>
