<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `ops/frontend.sh install` substitutes __REPO__ and __NODE_BIN__ for
  this machine and writes the result to ~/Library/LaunchAgents.
  Nothing here may name a user: the repo is cloned onto other machines. This
  file once carried one machine's absolute paths, and every other machine got
  `last exit code = 78: EX_CONFIG` from a WorkingDirectory that did not exist.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.missionhq.frontend</string>

  <!-- `npm run start` is `next start`. It serves the last `npm run build`.
       Run `npm run build` in frontend/ after every frontend change, then
       `ops/frontend.sh restart`. -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>npm</string>
    <string>run</string>
    <string>start</string>
    <string>--</string>
    <string>-p</string>
    <string>3000</string>
    <string>-H</string>
    <string>127.0.0.1</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/frontend</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd starts with almost no PATH, and node comes from Homebrew on
         one machine and nvm on another. __NODE_BIN__ is wherever `npm`
         actually resolved at install time, so both work without editing. -->
    <key>PATH</key>
    <string>__NODE_BIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <!-- Server-only. next.config.ts rewrites /api/* here. Caddy also routes
         /api/* to the backend directly, so this is only a fallback. -->
    <key>BACKEND_ORIGIN</key>
    <string>http://127.0.0.1:8000</string>
    <key>PORT</key>
    <string>3000</string>
  </dict>

  <!-- Start at login and restart whenever the process exits, crash or not. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>15</integer>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/frontend.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/frontend.log</string>
</dict>
</plist>
