{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://missionhq.local/video/narration.schema.json",
  "title": "Narration file (<id>.narration.json, video/SPEC.md)",
  "description": "Generated by video/scripts/build-schema.mjs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "engine": {
      "enum": [
        "kokoro",
        "say"
      ]
    },
    "voice": {
      "type": "string"
    },
    "rate": {
      "type": "number"
    },
    "speed": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 1.5
    },
    "lang": {
      "type": "string"
    },
    "fadeTailS": {
      "type": "number",
      "minimum": 0
    },
    "leadinS": {
      "type": "number",
      "minimum": 0
    },
    "holdS": {
      "type": "number",
      "minimum": 0
    },
    "gapS": {
      "type": "number",
      "minimum": 0
    },
    "beats": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(cold|title|c([1-9]|1[0-9]|20)|payoff|recap|end)$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chapter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "cueLeadS": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.5
          },
          "preDelayS": {
            "type": "number",
            "minimum": 0
          },
          "leadinS": {
            "type": "number",
            "minimum": 0
          },
          "holdS": {
            "type": "number",
            "minimum": 0
          },
          "gapS": {
            "type": "number",
            "minimum": 0
          },
          "voice": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z]{1,2}[0-9]+[a-z]?$",
                  "maxLength": 8
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "say": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 600
                },
                "voice": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "text"
              ]
            },
            "minItems": 1,
            "maxItems": 60
          }
        },
        "required": [
          "lines"
        ]
      }
    }
  },
  "required": [
    "beats"
  ]
}
