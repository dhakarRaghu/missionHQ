# Copy to .env and fill in. .env is gitignored; this file is the contract.

# --- Database (local Postgres now; paste a Neon DSN with ?sslmode=require later) ---
DATABASE_URL=postgresql://localhost:5432/missionhq

# --- LLM gateway (OpenAI-compatible) ---
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=replace-me

# Required when CODEX_CONFIG uses the bundled Juspay Grid provider.
GRID_API_KEY=

# Optional direct providers (only needed if models.yaml references them)
OPENAI_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me
OWNER_CHAT_ID=0

# Comma-separated owner/repo list the token may read, e.g. you/app,you/site

# --- Ops ---
CRON_TZ=Asia/Kolkata
DAILY_SPEND_CAP_USD=5.00
NOTIFICATIONS_PER_DAY=5
API_BEARER_TOKEN=replace-me-long-random
# Tailscale login (e.g. you@github) allowed to skip the bearer token. Empty = off.
TAILSCALE_OWNER_LOGIN=
HEALTHCHECKS_PING_URL=

# --- Privacy ---
# Your current and former employers, comma-separated, e.g. "Acme Corp,Globex".
# Kept here and nowhere else: no prompt, source file or test names them. Every
# agent write, search, fetch and brief that names one is refused (hq.privacy),
# and job boards and the job ledger skip them. Empty = no names to guard.
PRIVATE_EMPLOYERS=

# --- Cross-origin console (only when the frontend is hosted elsewhere, e.g. Vercel) ---
# Comma-separated list of exact origins allowed by CORS, scheme + host, no path,
# no wildcard. Example: https://hq.vercel.app,https://hq-git-main-you.vercel.app
# Empty = CORS off. Leave empty for the Tailscale/Caddy same-origin setup.
# The phone reader's sync (/api/reader/*) also needs its Vercel origin here,
# e.g. https://your-reader.vercel.app (docs/deploy.md §12).
CORS_ORIGINS=

# --- Bind address ---
# Keep 127.0.0.1 so only Caddy (or Tailscale Serve) on the same box can reach
# the backend. Only change it if you know why (for example a container network).
BIND_HOST=127.0.0.1
BIND_PORT=8000

# --- headed browser (browser_read) -----------------------------------------
# Opens a real Chrome window with its own profile, separate from the one you
# browse in. Off by default because it is a visible window, not a background
# fetch. The social platforms are refused in code regardless of this setting.
# Codex runtime (operator). The backend runs under launchd, which does not
# read ~/.zshrc, so a provider key exported there reaches your terminal and
# NOT this process: every operator run fails with "Missing environment
# variable" until the key reaches it from here.
#
# Simplest setup: point Codex at the same gateway Mission HQ already uses.
# Codex's own `grid` provider reads GRID_API_KEY, and the adapter forwards
# GATEWAY_API_KEY under that name, so there is one key rather than two.
# CODEX_RUNTIME_ENABLED=false
# CODEX_CONFIG=model_provider=grid
# CODEX_MODEL=claude-sonnet-4-6
#
# Pick a model the gateway serves over /v1/responses, which is the only wire
# format Codex's grid provider speaks. claude-sonnet-4-6, glm-latest and
# open-fast all answer it; kimi-latest does not.
#
# Only if you use a different provider (`head ~/.codex/config.toml` says
# which): set that provider's key instead.
# AZURE_OPENAI_API_KEY=
# OPENAI_API_KEY_FOR_CODEX=

# Bright Data: web search (SERP API) and LinkedIn/X reads (Web Scraper API).
# One key covers both. The free tier is 5,000 credits a month and stops dead
# when they run out, so an unfunded account can never be billed.
#   1. Create an account at brightdata.com
#   2. Add a *SERP API* zone under Web Access, and put its name below.
#      The Browser API is a different product and will not answer these calls.
#   3. Copy the key from Account settings.
# Without a key, hunter has no search and no LinkedIn reads; it still fetches
# URLs it can name.
# BRIGHTDATA_API_KEY=
# BRIGHTDATA_SERP_ZONE=serp_api1
# The Scrapers product (LinkedIn/X records) is off. It bills per record, not
# per request, so one jobs lookup matching forty postings costs forty credits.
# Operator reads those hosts in your own browser for nothing. Turn this on
# only if you decide the unpredictable cost is worth it, and grant
# social_lookup to hunter yourself.
# BRIGHTDATA_SCRAPERS_ENABLED=false

# Ceilings, both far below the 5,000 free credits, because a paid call is the
# last resort. One credit is one SERP request or one scraped record. A day of
# casual testing took 420, so these matter.
# BRIGHTDATA_DAILY_CALLS=40
# BRIGHTDATA_MONTHLY_CALLS=1200

# Days a finished task stays on the board before it is archived. 0 disables.
# BOARD_ARCHIVE_DAYS=14

BROWSER_ENABLED=false
# BROWSER_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# BROWSER_DEBUG_PORT=9223
# Seconds between page loads. A burst is what looks automated.
# BROWSER_MIN_INTERVAL_S=3.0

# --- codex runtime (agents with `runtime: codex`) --------------------------
# Hands one task to the Codex CLI, which can drive the browser you are signed
# into through the ChatGPT Chrome extension. Needs a desktop session and that
# extension, so enable it only on a machine that has both. Every such run
# opens an approval ticket before it starts.
CODEX_RUNTIME_ENABLED=false
# The ChatGPT desktop app bundles a copy that is not on PATH; it is found
# automatically. Set this only if yours lives somewhere else.
# CODEX_CLI_PATH=codex
# Optional comma-separated Codex config overrides. Each entry becomes one
# `-c` flag after `codex exec`; use this when the machine's CLI provider/model
# differ from its defaults.
# CODEX_CONFIG=model_provider=juspay,model=open-large
# Codex has no budget flag, so the timeout is the only ceiling on one run.
# CODEX_TIMEOUT_S=600
# Hours one approval of an external-runtime agent stays good for, so you can
# say "go" once rather than per run. It only ever covers reading through your
# browser: nothing in this system can act on the world at all. 0 asks every
# time.
# RUNTIME_APPROVAL_HOURS=12

# --- claude runtime (agents with `runtime: claude`) ------------------------
# Hands one task to the Claude Code CLI, which can drive the browser you are
# signed into through the Claude in Chrome extension. Needs a desktop session
# and that extension installed, so enable it only on a machine that has both.
# Every such run opens an approval ticket before it starts.
CLAUDE_RUNTIME_ENABLED=false
# CLAUDE_CLI_PATH=claude
# Browser tools only. In headless mode an unlisted tool is refused, not
# prompted for, so this line is the whole permission model for that process.
# CLAUDE_ALLOWED_TOOLS=mcp__claude-in-chrome__*
# CLAUDE_MAX_TURNS=25
# A hard ceiling in real dollars. A run that cannot reach a browser burns
# money discovering that, so this is not optional.
# CLAUDE_MAX_BUDGET_USD=1.00
# CLAUDE_TIMEOUT_S=600
