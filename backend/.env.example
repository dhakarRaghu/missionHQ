# Copy to .env and fill in. .env is gitignored; this file is the contract.

# --- Database (local Postgres now; paste a Neon DSN with ?sslmode=require later) ---
DATABASE_URL=postgresql://localhost:5432/missionhq

# --- LLM gateway (OpenAI-compatible) ---
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=replace-me

# Optional direct providers (only needed if models.yaml references them)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me
OWNER_CHAT_ID=0

# --- Ops ---
CRON_TZ=Asia/Kolkata
DAILY_SPEND_CAP_USD=5.00
NOTIFICATIONS_PER_DAY=5
API_BEARER_TOKEN=replace-me-long-random
HEALTHCHECKS_PING_URL=
