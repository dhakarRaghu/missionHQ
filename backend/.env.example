# Copy to .env and fill in. .env is gitignored; this file is the contract.

# --- Database (local Postgres now; paste a Neon DSN with ?sslmode=require later) ---
DATABASE_URL=postgresql://localhost:5432/missionhq

# --- LLM gateway (OpenAI-compatible) ---
GATEWAY_BASE_URL=https://your-gateway.example.com/v1
GATEWAY_API_KEY=replace-me

# Optional direct providers (only needed if models.yaml references them)
OPENAI_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=replace-me
OWNER_CHAT_ID=0

# Comma-separated owner/repo list the token may read, e.g. you/app,you/site

# --- Ops ---
CRON_TZ=Asia/Kolkata
DAILY_SPEND_CAP_USD=5.00
NOTIFICATIONS_PER_DAY=5
API_BEARER_TOKEN=replace-me-long-random
# Tailscale login (e.g. you@github) allowed to skip the bearer token. Empty = off.
TAILSCALE_OWNER_LOGIN=
HEALTHCHECKS_PING_URL=

# --- Cross-origin console (only when the frontend is hosted elsewhere, e.g. Vercel) ---
# Comma-separated list of exact origins allowed by CORS, scheme + host, no path,
# no wildcard. Example: https://hq.vercel.app,https://hq-git-main-you.vercel.app
# Empty = CORS off. Leave empty for the Tailscale/Caddy same-origin setup.
CORS_ORIGINS=

# --- Bind address ---
# Keep 127.0.0.1 so only Caddy (or Tailscale Serve) on the same box can reach
# the backend. Only change it if you know why (for example a container network).
BIND_HOST=127.0.0.1
BIND_PORT=8000
